{
  "name": "xuanyi-curiosity",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:export": "node scripts/check-export.mjs",
    "check:browser": "node scripts/check-browser.mjs && node scripts/check-cross-browser.mjs && node scripts/check-identity.mjs && node scripts/check-canvas.mjs && node scripts/check-response.mjs",
    "generate:identity": "tsx scripts/generate-identity.tsx",
    "measure:canvas": "node scripts/measure-canvas.mjs",
    "compare:canvas": "node scripts/compare-canvas.mjs",
    "check:strict": "node scripts/check-strict.mjs",
    "check:direction": "node scripts/check-direction.mjs",
    "record:direction": "node scripts/record-direction.mjs",
    "measure:direction": "node scripts/measure-direction.mjs",
    "check:passing": "node scripts/check-passing.mjs",
    "record:passing": "node scripts/record-passing.mjs",
    "compare:passing": "node scripts/compare-passing.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "gsap": "^3.14.2",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.13.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "playwright": "^1.58.2",
    "serve": "^14.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
